# Local development: demo data only. Never commit real secrets.
FLEXPASS_ENV=development
FLEXPASS_DEMO_MODE=true
FLEXPASS_SECRET=replace-with-a-long-random-secret-before-hosting
DATABASE_URL=sqlite:///flexpass.db
# Hosted production mode: set FLEXPASS_ENV=production and FLEXPASS_DEMO_MODE=false.
# Define FLEXPASS_ADMIN_EMAIL and FLEXPASS_ADMIN_PASSWORD (12+ characters).
# Alternatively, a hosted demo needs separate strong FLEXPASS_DEMO_<ROLE>_PASSWORD values.
