# Local development: demo data only. Never commit real secrets.
FLEXPASS_ENV=development
FLEXPASS_DEMO_MODE=true
FLEXPASS_SECRET=replace-with-a-long-random-secret-before-hosting
DATABASE_URL=sqlite:///flexpass.db
# Hosted production mode: set FLEXPASS_ENV=production and FLEXPASS_DEMO_MODE=false.
# Define FLEXPASS_ADMIN_EMAIL and FLEXPASS_ADMIN_PASSWORD (12+ characters).
# Alternatively, a hosted demo needs separate strong FLEXPASS_DEMO_<ROLE>_PASSWORD values.

# Invite-only account activation / transactional email (Render free supports HTTPS email APIs)
# Set this to your full-stack HTTPS Render URL (without a trailing slash).
FLEXPASS_APP_URL=https://your-flexpass-service.onrender.com
# Configure a verified sender domain and API key through Render environment variables.
FLEXPASS_RESEND_API_KEY=
FLEXPASS_EMAIL_FROM=
# SMTP is an alternative only when your host permits outbound SMTP.
FLEXPASS_SMTP_HOST=
FLEXPASS_SMTP_PORT=465
FLEXPASS_SMTP_FROM=
FLEXPASS_SMTP_USER=
FLEXPASS_SMTP_PASSWORD=

# Optional: real bank transfer details only after approved (production).
# Never use fictional demo values as actual transfer instructions.
FLEXPASS_BANK_NAME=
FLEXPASS_BANK_BENEFICIARY=
FLEXPASS_BANK_IBAN=
# Simulated bank transfer is automatically available only when FLEXPASS_ENV=development/test/staging
# and FLEXPASS_DEMO_MODE=true. It is always disabled in production.
